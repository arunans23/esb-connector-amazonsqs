{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Output Schema for ChangeMessageVisibilityBatch Operation",
  "description": "Output schema for the changeMessageVisibilityBatch operation in the connector.",
  "properties": {
    "payload": {
      "type": "object",
      "description": "The main response payload from the changeMessageVisibilityBatch operation.",
      "properties": {
        "Successful": {
          "type": "array",
          "description": "A list of entries for messages whose visibility timeout was successfully changed.",
          "items": {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string",
                "description": "The ID of the message."
              }
            },
            "required": ["Id"],
            "additionalProperties": false
          }
        },
        "Failed": {
          "type": "array",
          "description": "A list of entries for messages whose visibility timeout change failed.",
          "items": {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string",
                "description": "The ID of the message."
              },
              "SenderFault": {
                "type": "boolean",
                "description": "Indicates whether the error was on the sender's side."
              },
              "Code": {
                "type": "string",
                "description": "The error code."
              },
              "Message": {
                "type": "string",
                "description": "A description of the error."
              }
            },
            "required": ["Id", "SenderFault", "Code", "Message"],
            "additionalProperties": false
          }
        }
      },
      "required": ["Successful", "Failed"]
    },
    "attributes": {
      "type": "object",
      "description": "Metadata about the changeMessageVisibilityBatch operation.",
      "properties": {
        "operationSuccessful": {
          "type": "boolean",
          "description": "Indicates whether the SQS API call was successful (does not mean all batch items succeeded)."
        },
        "requestId": {
          "type": "string",
          "description": "The AWS request ID for the SQS operation."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "payload",
    "attributes"
  ],
  "additionalProperties": false
}
